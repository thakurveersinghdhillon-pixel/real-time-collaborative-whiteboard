# ===================================================================
# Real-Time Collaborative Whiteboard — Production Environment Configuration
# ===================================================================

# Global Node Environment
NODE_ENV=production

# Backend Server Configuration
PORT=3001
INSTANCE_ID=server-1
CORS_ORIGIN=*

# Cryptographic Identity & Authentication (Phase 6)
# Required in production. Fail fast if missing or empty.
JWT_SECRET=production-super-secret-jwt-key-phase8
JWT_EXPIRES_IN=7d

# PostgreSQL Persistent Database (Phase 5 & 7)
DATABASE_URL=postgresql://whiteboard:whiteboard@localhost:5432/whiteboard

# Redis Pub/Sub Broker (Phase 4 & 7)
REDIS_URL=redis://127.0.0.1:6379

# Next.js Web Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
